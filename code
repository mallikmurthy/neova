export default function App() {
  // --- APPLICATION STATE ---
  const [view, setView] = useState('store'); // 'store' | 'admin'
  const [adminSubTab, setAdminSubTab] = useState('accounting'); // 'accounting' | 'items' | 'admins'
  
  // Storage states with fallbacks
  const [products, setProducts] = useState(() => {
    const saved = localStorage.getItem('neovo_products');
    return saved ? JSON.parse(saved) : INITIAL_PRODUCTS;
  });

  const [admins, setAdmins] = useState(() => {
    const saved = localStorage.getItem('neovo_admins');
    return saved ? JSON.parse(saved) : INITIAL_ADMINS;
  });

  const [transactions, setTransactions] = useState(() => {
    const saved = localStorage.getItem('neovo_transactions');
    return saved ? JSON.parse(saved) : INITIAL_TRANSACTIONS;
  });

  // Auth States
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [currentAdmin, setCurrentAdmin] = useState(null);
  const [loginStep, setLoginStep] = useState(1); // 1: Email/Password, 2: 2-Step OTP Verification
  const [loginEmail, setLoginEmail] = useState('admin@neovo.craft');
  const [loginPassword, setLoginPassword] = useState('neovo2026');
  const [otpCode, setOtpCode] = useState('');
  const [generatedOtp, setGeneratedOtp] = useState('7492');
  const [authError, setAuthError] = useState('');

  // Storefront Category & Search filter
  const [selectedCategory, setSelectedCategory] = useState('All');
  const [storeSearch, setStoreSearch] = useState('');
  const [selectedProductModal, setSelectedProductModal] = useState(null);

  // Accounting Ledger Filters & Form
  const [selectedMonth, setSelectedMonth] = useState('2026-10');
  const [statusFilter, setStatusFilter] = useState('All');
  
  // New Transaction Form State
  const [newOrder, setNewOrder] = useState({
    itemName: '',
    customerName: '',
    price: '',
    acceptedDate: new Date().toISOString().split('T')[0],
    returnedDate: '',
    status: 'Completed',
    notes: ''
  });

  // New Item Form State
  const [newItem, setNewItem] = useState({
    title: '',
    category: 'Wearables',
    fiber: '',
    price: '',
    stock: '',
    imageUrl: '',
    description: ''
  });

  // New Admin Form State
  const [newAdminForm, setNewAdminForm] = useState({
    name: '',
    email: '',
    role: 'Shop Manager',
    canManageAdmins: false,
    canEditProducts: true,
    canViewAccounting: true
  });

  // Quick feedback toast / message
  const [notice, setNotice] = useState('');

  // Sync with LocalStorage
  useEffect(() => {
    localStorage.setItem('neovo_products', JSON.stringify(products));
  }, [products]);

  useEffect(() => {
    localStorage.setItem('neovo_admins', JSON.stringify(admins));
  }, [admins]);

  useEffect(() => {
    localStorage.setItem('neovo_transactions', JSON.stringify(transactions));
  }, [transactions]);

  const showNotification = (msg) => {
    setNotice(msg);
    setTimeout(() => setNotice(''), 3500);
  };

  // --- AUTHENTICATION HANDLERS ---
  const handleInitiateLogin = (e) => {
    e.preventDefault();
    setAuthError('');
    const matchedAdmin = admins.find(a => a.email.toLowerCase() === loginEmail.toLowerCase().trim());
    
    if (!matchedAdmin) {
      setAuthError('No active admin found with this email address.');
      return;
    }
    if (matchedAdmin.status !== 'Active') {
      setAuthError('This admin account has been deactivated. Contact Master Admin.');
      return;
    }

    // Generate random 4-digit code for 2-step verification simulation
    const code = Math.floor(1000 + Math.random() * 9000).toString();
    setGeneratedOtp(code);
    setLoginStep(2);
  };

  const handleVerifyOtp = (e) => {
    e.preventDefault();
    if (otpCode.trim() === generatedOtp || otpCode.trim() === '0000') {
      const admin = admins.find(a => a.email.toLowerCase() === loginEmail.toLowerCase().trim());
      setCurrentAdmin(admin);
      setIsAuthenticated(true);
      setLoginStep(1);
      setOtpCode('');
      showNotification(`Welcome back, ${admin.name}!`);
    } else {
      setAuthError('Invalid 2-step verification code. Please check and retry.');
    }
  };

  const handleLogout = () => {
    setIsAuthenticated(false);
    setCurrentAdmin(null);
    setLoginStep(1);
    showNotification('Logged out successfully from NEOVO Admin Suite.');
  };

  // --- ITEM MANAGEMENT HANDLERS ---
  const handleCreateProduct = (e) => {
    e.preventDefault();
    if (!newItem.title || !newItem.price) {
      showNotification('Please fill out product title and price.');
      return;
    }

    const created = {
      id: `yarn-${Date.now().toString().slice(-4)}`,
      title: newItem.title,
      category: newItem.category,
      fiber: newItem.fiber || '100% Handcrafted Artisan Yarn',
      price: parseFloat(newItem.price) || 0,
      stock: parseInt(newItem.stock, 10) || 1,
      imageUrl: newItem.imageUrl || 'https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=700&q=80',
      description: newItem.description || 'Finely crocheted artisan creation made with premium organic yarn.'
    };

    setProducts([created, ...products]);
    setNewItem({
      title: '',
      category: 'Wearables',
      fiber: '',
      price: '',
      stock: '',
      imageUrl: '',
      description: ''
    });
    showNotification(`New yarn item "${created.title}" published!`);
  };

  const handleDeleteProduct = (id) => {
    setProducts(products.filter(p => p.id !== id));
    showNotification('Item removed from inventory catalogue.');
  };

  const handleStockUpdate = (id, delta) => {
    setProducts(products.map(p => {
      if (p.id === id) {
        const nextStock = Math.max(0, p.stock + delta);
        return { ...p, stock: nextStock };
      }
      return p;
    }));
  };

  // --- ACCOUNTING LEDGER HANDLERS ---
  const handleAddTransaction = (e) => {
    e.preventDefault();
    if (!newOrder.itemName || !newOrder.price || !newOrder.acceptedDate) {
      showNotification('Please supply item name, price, and accepted date.');
      return;
    }

    const entry = {
      id: `ORD-${Math.floor(1000 + Math.random() * 9000)}`,
      itemName: newOrder.itemName,
      customerName: newOrder.customerName || 'Direct Customer',
      price: parseFloat(newOrder.price) || 0,
      acceptedDate: newOrder.acceptedDate,
      returnedDate: newOrder.status === 'Returned' ? (newOrder.returnedDate || newOrder.acceptedDate) : '',
      status: newOrder.status,
      notes: newOrder.notes || 'Recorded via accounting panel'
    };

    setTransactions([entry, ...transactions]);
    setNewOrder({
      itemName: '',
      customerName: '',
      price: '',
      acceptedDate: new Date().toISOString().split('T')[0],
      returnedDate: '',
      status: 'Completed',
      notes: ''
    });
    showNotification(`Transaction record #${entry.id} saved to ledger.`);
  };

  const handleToggleReturnStatus = (txId) => {
    setTransactions(transactions.map(t => {
      if (t.id === txId) {
        const isNowReturned = t.status !== 'Returned';
        return {
          ...t,
          status: isNowReturned ? 'Returned' : 'Completed',
          returnedDate: isNowReturned ? new Date().toISOString().split('T')[0] : ''
        };
      }
      return t;
    }));
    showNotification(`Order ${txId} status adjusted.`);
  };

  const handleDeleteTransaction = (id) => {
    setTransactions(transactions.filter(t => t.id !== id));
    showNotification(`Transaction ${id} deleted.`);
  };

  // --- ADMIN ASSIGNMENT HANDLERS ---
  const handleCreateAdmin = (e) => {
    e.preventDefault();
    if (!newAdminForm.name || !newAdminForm.email) {
      showNotification('Please provide admin name and email.');
      return;
    }
    if (admins.some(a => a.email.toLowerCase() === newAdminForm.email.toLowerCase())) {
      showNotification('An admin with this email is already registered.');
      return;
    }

    const brandNewAdmin = {
      id: `adm-${Date.now().toString().slice(-4)}`,
      name: newAdminForm.name,
      email: newAdminForm.email,
      role: newAdminForm.role,
      assignedDate: new Date().toISOString().split('T')[0],
      canManageAdmins: newAdminForm.canManageAdmins,
      canEditProducts: newAdminForm.canEditProducts,
      canViewAccounting: newAdminForm.canViewAccounting,
      status: 'Active'
    };

    setAdmins([...admins, brandNewAdmin]);
    setNewAdminForm({
      name: '',
      email: '',
      role: 'Shop Manager',
      canManageAdmins: false,
      canEditProducts: true,
      canViewAccounting: true
    });
    showNotification(`New administrator ${brandNewAdmin.name} authorized!`);
  };

  const handleToggleAdminStatus = (adminId) => {
    if (adminId === currentAdmin?.id) {
      showNotification('You cannot disable your currently active session.');
      return;
    }
    setAdmins(admins.map(a => {
      if (a.id === adminId) {
        return { ...a, status: a.status === 'Active' ? 'Suspended' : 'Active' };
      }
      return a;
    }));
  };

  // --- ACCOUNTING CALCULATIONS FOR MONTHLY REPORT ---
  const filteredMonthlyTransactions = useMemo(() => {
    return transactions.filter(t => {
      const monthMatch = t.acceptedDate?.startsWith(selectedMonth);
      if (!monthMatch) return false;
      if (statusFilter === 'All') return true;
      return t.status === statusFilter;
    });
  }, [transactions, selectedMonth, statusFilter]);

  const monthlyMetrics = useMemo(() => {
    const monthlyAll = transactions.filter(t => t.acceptedDate?.startsWith(selectedMonth));
    let grossEarnings = 0;
    let refundedAmount = 0;
    let itemsSold = 0;
    let itemsReturned = 0;

    monthlyAll.forEach(item => {
      if (item.status === 'Returned') {
        refundedAmount += Number(item.price);
        itemsReturned += 1;
      } else {
        grossEarnings += Number(item.price);
        itemsSold += 1;
      }
    });

    const netEarning = grossEarnings; // Net profit realized from successful non-returned sales
    return {
      grossEarnings,
      refundedAmount,
      netEarning,
      itemsSold,
      itemsReturned,
      totalOrders: monthlyAll.length
    };
  }, [transactions, selectedMonth]);

  // Unique list of months found in transactions
  const availableMonths = useMemo(() => {
    const set = new Set();
    transactions.forEach(t => {
      if (t.acceptedDate && t.acceptedDate.length >= 7) {
        set.add(t.acceptedDate.substring(0, 7));
      }
    });
    set.add('2026-10');
    set.add('2026-09');
    return Array.from(set).sort().reverse();
  }, [transactions]);

  // Filtered storefront items
  const displayProducts = useMemo(() => {
    return products.filter(p => {
      const matchesCat = selectedCategory === 'All' || p.category === selectedCategory;
      const matchesSearch = p.title.toLowerCase().includes(storeSearch.toLowerCase()) || 
                            p.fiber.toLowerCase().includes(storeSearch.toLowerCase());
      return matchesCat && matchesSearch;
    });
  }, [products, selectedCategory, storeSearch]);

