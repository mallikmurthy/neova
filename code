                              <td className="py-3.5 px-4 text-[#2C352E]/70">
                                {tx.customerName}
                              </td>
                              <td className="py-3.5 px-4 font-serif font-bold text-[#2C352E]">
                                ₹{Number(tx.price).toLocaleString('en-IN')}
                              </td>
                              <td className="py-3.5 px-4 text-[#2C352E]/80">
                                <span className="inline-flex items-center gap-1">
                                  <Clock className="w-3 h-3 text-[#2C352E]/40" />
                                  {tx.acceptedDate}
                                </span>
                              </td>
                              <td className="py-3.5 px-4">
                                {tx.returnedDate ? (
                                  <span className="text-rose-700 font-medium inline-flex items-center gap-1">
                                    <RotateCcw className="w-3 h-3 text-rose-600" />
                                    {tx.returnedDate}
                                  </span>
                                ) : (
                                  <span className="text-[#2C352E]/30 italic">—</span>
                                )}
                              </td>
                              <td className="py-3.5 px-4">
                                <span className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold ${
                                  tx.status === 'Completed'
                                    ? 'bg-emerald-100 text-emerald-800'
                                    : 'bg-rose-100 text-rose-800'
                                }`}>
                                  {tx.status}
                                </span>
                              </td>
                              <td className="py-3.5 px-4 text-right space-x-1">
                                <button
                                  onClick={() => handleToggleReturnStatus(tx.id)}
                                  title={tx.status === 'Completed' ? 'Mark as Returned' : 'Revert to Completed'}
                                  className="p-1.5 rounded-lg text-[#2C352E]/70 hover:bg-[#EFECE3] hover:text-[#2C352E] transition-colors"
                                >
                                  <RotateCcw className="w-3.5 h-3.5" />
                                </button>
                                <button
                                  onClick={() => handleDeleteTransaction(tx.id)}
                                  title="Delete record"
                                  className="p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 transition-colors"
                                >
                                  <Trash2 className="w-3.5 h-3.5" />
                                </button>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>

                      {filteredMonthlyTransactions.length === 0 && (
                        <div className="py-12 text-center text-[#2C352E]/50">
                          <DollarSign className="w-8 h-8 mx-auto mb-2 opacity-30" />
                          <p className="text-xs">No transaction records found for this period filter.</p>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              )}

              {/* ------------------------------------------------------------- */}
              {/* TAB 2: MANAGE YARN ITEMS (ADD & INVENTORY) */}
              {/* ------------------------------------------------------------- */}
              {adminSubTab === 'items' && (
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
                  
                  {/* Left Column: Add Product Form */}
                  <div className="bg-white/80 rounded-2xl p-6 border border-[#2C352E]/10 shadow-sm space-y-4 h-fit">
                    <div className="border-b border-[#2C352E]/10 pb-3">
                      <h4 className="font-serif text-base font-bold text-[#2C352E] flex items-center gap-2">
                        <Package className="w-4 h-4" />
                        Add New Yarn Creation
                      </h4>
                      <p className="text-xs text-[#2C352E]/60 mt-0.5">
                        Item will appear instantly in the boutique storefront.
                      </p>
                    </div>

                    <form onSubmit={handleCreateProduct} className="space-y-3.5">
                      <div>
                        <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                          Product Title *
                        </label>
                        <input
                          type="text"
                          placeholder="e.g. Mohair Knit Cocoon Wrap"
                          value={newItem.title}
                          onChange={(e) => setNewItem({ ...newItem, title: e.target.value })}
                          required
                          className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none focus:ring-1 focus:ring-[#2C352E]"
                        />
                      </div>

                      <div className="grid grid-cols-2 gap-2">
                        <div>
                          <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                            Category
                          </label>
                          <select
                            value={newItem.category}
                            onChange={(e) => setNewItem({ ...newItem, category: e.target.value })}
                            className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none"
                          >
                            <option value="Wearables">Wearables</option>
                            <option value="Accessories">Accessories</option>
                            <option value="Home Decor">Home Decor</option>
                            <option value="Plushies">Plushies</option>
                          </select>
                        </div>

                        <div>
                          <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                            Price (₹) *
                          </label>
                          <input
                            type="number"
                            placeholder="2200"
                            value={newItem.price}
                            onChange={(e) => setNewItem({ ...newItem, price: e.target.value })}
                            required
                            className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none"
                          />
                        </div>
                      </div>

                      <div className="grid grid-cols-2 gap-2">
                        <div>
                          <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                            Stock Units
                          </label>
                          <input
                            type="number"
                            placeholder="10"
                            value={newItem.stock}
                            onChange={(e) => setNewItem({ ...newItem, stock: e.target.value })}
                            className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none"
                          />
                        </div>

                        <div>
                          <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                            Yarn Fiber Composition
                          </label>
                          <input
                            type="text"
                            placeholder="e.g. 70% Mohair, 30% Silk"
                            value={newItem.fiber}
                            onChange={(e) => setNewItem({ ...newItem, fiber: e.target.value })}
                            className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none"
                          />
                        </div>
                      </div>

                      <div>
                        <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                          Product Image URL
                        </label>
                        <input
                          type="url"
                          placeholder="https://images.unsplash.com/..."
                          value={newItem.imageUrl}
                          onChange={(e) => setNewItem({ ...newItem, imageUrl: e.target.value })}
                          className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none"
                        />
                      </div>

                      <div>
                        <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                          Item Description
                        </label>
                        <textarea
                          rows={3}
                          placeholder="Handcrafted stitch pattern details, sizing, and softness notes..."
                          value={newItem.description}
                          onChange={(e) => setNewItem({ ...newItem, description: e.target.value })}
                          className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none"
                        />
                      </div>

                      <button
                        type="submit"
                        className="w-full py-2.5 bg-[#2C352E] text-[#F5F2EB] text-xs uppercase tracking-wider font-semibold rounded-xl hover:bg-[#3D473F] transition-all flex items-center justify-center space-x-2 shadow"
                      >
                        <PlusCircle className="w-3.5 h-3.5" />
                        <span>Publish Yarn Item</span>
                      </button>
                    </form>
                  </div>

                  {/* Right Column: Existing Items List with Quick Stock Adjustment */}
                  <div className="lg:col-span-2 space-y-4">
                    <div className="bg-white/80 p-4 rounded-2xl border border-[#2C352E]/10 flex items-center justify-between">
                      <h4 className="font-serif text-base font-bold text-[#2C352E]">
                        Active Catalogue ({products.length} Products)
                      </h4>
                      <span className="text-xs text-[#2C352E]/60">Adjust stock or remove items</span>
                    </div>

                    <div className="space-y-3">
                      {products.map((product) => (
                        <div 
                          key={product.id}
                          className="bg-white/80 p-4 rounded-2xl border border-[#2C352E]/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:shadow-sm transition-all"
                        >
                          <div className="flex items-center space-x-3.5">
                            <img 
                              src={product.imageUrl} 
                              alt={product.title} 
                              className="w-16 h-16 rounded-xl object-cover border border-[#2C352E]/10"
                            />
                            <div>
                              <span className="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-[#EFECE3] text-[#2C352E]">
                                {product.category}
                              </span>
                              <h5 className="font-serif text-sm font-bold text-[#2C352E] mt-1">
                                {product.title}
                              </h5>
                              <p className="text-[11px] text-[#2C352E]/60">{product.fiber}</p>
                            </div>
                          </div>

                          <div className="flex items-center justify-between sm:justify-end gap-6 border-t sm:border-t-0 pt-2 sm:pt-0 border-[#2C352E]/10">
                            <div>
                              <span className="text-[10px] text-[#2C352E]/60 uppercase block">Price</span>
                              <span className="font-serif text-base font-bold text-[#2C352E]">
                                ₹{product.price.toLocaleString('en-IN')}
                              </span>
                            </div>

                            {/* Stock increment/decrement */}
                            <div className="text-center">
                              <span className="text-[10px] text-[#2C352E]/60 uppercase block">Stock</span>
                              <div className="flex items-center space-x-1.5 mt-0.5 bg-[#EFECE3] px-2 py-1 rounded-lg">
                                <button
                                  onClick={() => handleStockUpdate(product.id, -1)}
                                  className="w-5 h-5 flex items-center justify-center font-bold text-xs hover:bg-white rounded"
                                >
                                  -
                                </button>
                                <span className="font-semibold text-xs min-w-[1.2rem] text-center">
                                  {product.stock}
                                </span>
                                <button
                                  onClick={() => handleStockUpdate(product.id, 1)}
                                  className="w-5 h-5 flex items-center justify-center font-bold text-xs hover:bg-white rounded"
                                >
                                  +
                                </button>
                              </div>
                            </div>

                            <button
                              onClick={() => handleDeleteProduct(product.id)}
                              className="p-2 text-rose-600 hover:bg-rose-50 rounded-xl transition-colors"
                              title="Delete Item"
                            >
                              <Trash2 className="w-4 h-4" />
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {/* ------------------------------------------------------------- */}
              {/* TAB 3: ADMIN ASSIGNMENT & ROLE DELEGATION */}
              {/* ------------------------------------------------------------- */}
              {adminSubTab === 'admins' && (
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
                  
                  {/* Left Column: Assign New Admin Form */}
                  <div className="bg-white/80 rounded-2xl p-6 border border-[#2C352E]/10 shadow-sm space-y-4 h-fit">
                    <div className="border-b border-[#2C352E]/10 pb-3">
                      <h4 className="font-serif text-base font-bold text-[#2C352E] flex items-center gap-2">
                        <UserPlus className="w-4 h-4" />
                        Assign New Admin Access
                      </h4>
                      <p className="text-xs text-[#2C352E]/60 mt-0.5">
                        Grant administrative credentials to a team member.
                      </p>
                    </div>

                    <form onSubmit={handleCreateAdmin} className="space-y-3.5">
                      <div>
                        <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                          Full Name *
                        </label>
                        <input
                          type="text"
                          placeholder="e.g. Tara Mehta"
                          value={newAdminForm.name}
                          onChange={(e) => setNewAdminForm({ ...newAdminForm, name: e.target.value })}
                          required
                          className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none focus:ring-1 focus:ring-[#2C352E]"
                        />
                      </div>

                      <div>
                        <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                          Work Email *
                        </label>
                        <input
                          type="email"
                          placeholder="e.g. tara@neovo.craft"
                          value={newAdminForm.email}
                          onChange={(e) => setNewAdminForm({ ...newAdminForm, email: e.target.value })}
                          required
                          className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none focus:ring-1 focus:ring-[#2C352E]"
                        />
                      </div>

                      <div>
                        <label className="block text-[11px] font-semibold text-[#2C352E]/80 mb-1">
                          Assigned Role
                        </label>
                        <select
                          value={newAdminForm.role}
                          onChange={(e) => setNewAdminForm({ ...newAdminForm, role: e.target.value })}
                          className="w-full px-3 py-2 text-xs bg-white rounded-xl border border-[#2C352E]/20 focus:outline-none"
                        >
                          <option value="Shop Manager">Shop Manager (Inventory & Sales)</option>
                          <option value="Financial Officer">Financial Officer (Accounting only)</option>
                          <option value="Master Admin">Master Admin (Full Rights)</option>
                        </select>
                      </div>

                      <div className="pt-2 border-t border-[#2C352E]/10 space-y-2">
                        <span className="block text-[11px] font-semibold text-[#2C352E]/80">
                          Permissions:
                        </span>
                        
                        <label className="flex items-center space-x-2 text-xs cursor-pointer">
                          <input
                            type="checkbox"
                            checked={newAdminForm.canEditProducts}
                            onChange={(e) => setNewAdminForm({ ...newAdminForm, canEditProducts: e.target.checked })}
                            className="rounded text-[#2C352E]"
                          />
                          <span>Can Add & Modify Yarn Items</span>
                        </label>

                        <label className="flex items-center space-x-2 text-xs cursor-pointer">
                          <input
                            type="checkbox"
                            checked={newAdminForm.canViewAccounting}
                            onChange={(e) => setNewAdminForm({ ...newAdminForm, canViewAccounting: e.target.checked })}
                            className="rounded text-[#2C352E]"
                          />
                          <span>Can Access Accounting & Sales Reports</span>
                        </label>

                        <label className="flex items-center space-x-2 text-xs cursor-pointer">
                          <input
                            type="checkbox"
                            checked={newAdminForm.canManageAdmins}
                            onChange={(e) => setNewAdminForm({ ...newAdminForm, canManageAdmins: e.target.checked })}
                            className="rounded text-[#2C352E]"
                          />
                          <span>Can Assign Other Admins</span>
                        </label>
                      </div>

                      <button
                        type="submit"
                        className="w-full py-2.5 bg-[#2C352E] text-[#F5F2EB] text-xs uppercase tracking-wider font-semibold rounded-xl hover:bg-[#3D473F] transition-all flex items-center justify-center space-x-2 shadow"
                      >
                        <ShieldCheck className="w-3.5 h-3.5 text-[#D4C3A3]" />
                        <span>Authorize Admin</span>
                      </button>
                    </form>
                  </div>

                  {/* Right Column: Active Admins Team List */}
                  <div className="lg:col-span-2 space-y-4">
                    <div className="bg-white/80 p-4 rounded-2xl border border-[#2C352E]/10 flex items-center justify-between">
                      <h4 className="font-serif text-base font-bold text-[#2C352E]">
                        Authorized Administration Team ({admins.length})
                      </h4>
                      <span className="text-xs text-[#2C352E]/60">2-Factor protected accounts</span>
                    </div>

                    <div className="space-y-3">
                      {admins.map((admin) => (
                        <div 
                          key={admin.id}
                          className="bg-white/80 p-5 rounded-2xl border border-[#2C352E]/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:shadow-sm transition-all"
                        >
                          <div className="flex items-start space-x-3.5">
                            <div className="w-10 h-10 rounded-full bg-[#2C352E] text-[#D4C3A3] flex items-center justify-center font-bold text-sm">
                              {admin.name.charAt(0)}
                            </div>
                            <div>
                              <div className="flex items-center space-x-2">
                                <h5 className="font-serif text-sm font-bold text-[#2C352E]">
                                  {admin.name}
                                </h5>
                                <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#EFECE3] text-[#2C352E]">
                                  {admin.role}
                                </span>
                              </div>
                              <p className="text-xs text-[#2C352E]/70">{admin.email}</p>
                              
                              <div className="flex flex-wrap gap-2 mt-2 text-[10px] text-[#2C352E]/60">
                                <span className="bg-[#FAF8F5] px-2 py-0.5 rounded border border-[#2C352E]/10">
                                  Assigned: {admin.assignedDate}
                                </span>
                                {admin.canManageAdmins && (
                                  <span className="bg-amber-100 text-amber-900 px-2 py-0.5 rounded">
                                    Can Manage Admins
                                  </span>
                                )}
                              </div>
                            </div>
                          </div>

                          <div className="flex items-center justify-end space-x-3 border-t sm:border-t-0 pt-2 sm:pt-0 border-[#2C352E]/10">
                            <span className={`text-[11px] font-bold px-2.5 py-1 rounded-full ${
                              admin.status === 'Active' 
                                ? 'bg-emerald-100 text-emerald-800' 
                                : 'bg-rose-100 text-rose-800'
                            }`}>
                              {admin.status}
                            </span>

                            {/* Enable / Disable Admin Access */}
                            {admin.id !== currentAdmin?.id && (
                              <button
                                onClick={() => handleToggleAdminStatus(admin.id)}
                                className={`px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors ${
                                  admin.status === 'Active'
                                    ? 'bg-rose-50 text-rose-700 hover:bg-rose-100'
                                    : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100'
                                }`}
                              >
                                {admin.status === 'Active' ? 'Revoke Access' : 'Reactivate'}
                              </button>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

            </div>
          )}
        </div>
      )}

      {/* ========================================================================= */}
      {/* 3. PRODUCT DETAIL MODAL */}
      {/* ========================================================================= */}
      {selectedProductModal && (
        <div className="fixed inset-0 z-50 bg-[#2C352E]/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#FAF8F5] rounded-3xl max-w-xl w-full border border-[#2C352E]/20 shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div className="relative h-72 bg-[#EAE5D9]">
              <img 
                src={selectedProductModal.imageUrl} 
                alt={selectedProductModal.title}
                className="w-full h-full object-cover" 
              />
              <button
                onClick={() => setSelectedProductModal(null)}
                className="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-black/70 transition-colors"
              >
                ✕
              </button>
              <span className="absolute bottom-4 left-4 bg-[#2C352E] text-[#F5F2EB] text-xs font-semibold px-3 py-1 rounded-full">
                {selectedProductModal.category}
              </span>
            </div>

            <div className="p-6 space-y-4">
              <div>
                <p className="text-xs uppercase font-serif tracking-widest text-[#2C352E]/60">
                  {selectedProductModal.fiber}
                </p>
                <h3 className="font-serif text-2xl font-bold text-[#2C352E] mt-1">
                  {selectedProductModal.title}
                </h3>
              </div>

              <p className="text-xs text-[#2C352E]/80 leading-relaxed">
                {selectedProductModal.description}
              </p>

              <div className="flex items-center justify-between p-4 bg-white/70 rounded-2xl border border-[#2C352E]/10">
                <div>
                  <span className="text-[10px] uppercase text-[#2C352E]/60 block">Price</span>
                  <span className="font-serif text-2xl font-bold text-[#2C352E]">
                    ₹{selectedProductModal.price.toLocaleString('en-IN')}
                  </span>
                </div>
                <div className="text-right">
                  <span className="text-[10px] uppercase text-[#2C352E]/60 block">Availability</span>
                  <span className={`text-xs font-bold ${selectedProductModal.stock > 0 ? 'text-emerald-700' : 'text-rose-700'}`}>
                    {selectedProductModal.stock > 0 ? `${selectedProductModal.stock} units ready to ship` : 'Made-to-order only'}
                  </span>
                </div>
              </div>

              <div className="flex gap-3 pt-2">
                <button
                  onClick={() => {
                    showNotification(`Inquiry logged for "${selectedProductModal.title}". Our yarn artisan will contact you!`);
                    setSelectedProductModal(null);
                  }}
                  className="flex-1 py-3 bg-[#2C352E] text-[#F5F2EB] text-xs uppercase tracking-wider font-semibold rounded-xl hover:bg-[#3D473F] transition-all flex items-center justify-center space-x-2"
                >
                  <ShoppingBag className="w-4 h-4" />
                  <span>Reserve Handcrafted Piece</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* FOOTER */}
      <footer className="mt-20 border-t border-[#2C352E]/10 bg-[#EFECE3]/60 py-10">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#2C352E]/70">
          <div className="flex items-center space-x-2">
            <span className="font-serif font-bold text-sm tracking-widest text-[#2C352E]">NEOVO</span>
            <span>• Artisanal Yarn Goods & Sustainable Textile Studio</span>
          </div>
          <p>© 2026 NEOVO Atelier. All rights reserved.</p>
        </div>
      </footer>

    </div>
  );
}
