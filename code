    <div className="min-h-screen bg-[#F5F2EB] text-[#2C352E] font-sans antialiased selection:bg-[#D4C3A3] selection:text-[#2C352E]">
      
      {/* Toast Notification */}
      {notice && (
        <div className="fixed bottom-6 right-6 z-50 bg-[#2C352E] text-[#F5F2EB] px-5 py-3 rounded-xl shadow-2xl flex items-center space-x-3 text-sm border border-[#D4C3A3]/30 animate-bounce">
          <Sparkles className="w-4 h-4 text-[#D4C3A3]" />
          <span>{notice}</span>
        </div>
      )}

      {/* TOP LUXURY NAVBAR */}
      <header className="sticky top-0 z-40 bg-[#F5F2EB]/95 backdrop-blur-md border-b border-[#2C352E]/10">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
          
          {/* Brand Logo with circular seal emblem */}
          <div 
            onClick={() => setView('store')}
            className="flex items-center space-x-3 cursor-pointer group select-none"
          >
            {/* SVG Emblem echoing provided NEOVO circular emblem */}
            <div className="relative w-12 h-12 rounded-full border-2 border-[#2C352E] bg-[#EFECE3] flex items-center justify-center p-1 shadow-sm transition-transform group-hover:scale-105">
              <svg viewBox="0 0 100 100" className="w-full h-full text-[#2C352E]">
                <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" strokeWidth="2.5" />
                <circle cx="50" cy="50" r="41" fill="none" stroke="currentColor" strokeWidth="1" strokeDasharray="3 2" />
                {/* Styled N monogram with botanical sprout */}
                <path 
                  d="M36 72 V28 C36 28 42 36 50 48 L64 68 V28" 
                  fill="none" 
                  stroke="currentColor" 
                  strokeWidth="4" 
                  strokeLinecap="round" 
                  strokeLinejoin="round" 
                />
                {/* Delicate leaf branch */}
                <path 
                  d="M62 38 C68 30 76 29 80 28 C79 34 76 40 70 42 C74 46 76 52 74 56 C68 53 64 47 62 38 Z" 
                  fill="currentColor" 
                />
              </svg>
            </div>
            <div>
              <span className="font-serif tracking-[0.25em] text-2xl font-bold uppercase text-[#2C352E] block">
                NEOVO
              </span>
              <span className="text-[10px] tracking-widest uppercase text-[#2C352E]/60 -mt-1 block font-medium">
                Artisanal Yarn & Crochet
              </span>
            </div>
          </div>

          {/* Mode Switchers & Auth */}
          <div className="flex items-center space-x-3">
            <button
              onClick={() => setView('store')}
              className={`px-4 py-2 text-xs uppercase tracking-wider font-semibold rounded-full transition-all flex items-center space-x-1.5 ${
                view === 'store'
                  ? 'bg-[#2C352E] text-[#F5F2EB] shadow-sm'
                  : 'bg-white/60 text-[#2C352E] hover:bg-white'
              }`}
            >
              <ShoppingBag className="w-3.5 h-3.5" />
              <span>Boutique Catalog</span>
            </button>

            <button
              onClick={() => setView('admin')}
              className={`px-4 py-2 text-xs uppercase tracking-wider font-semibold rounded-full transition-all flex items-center space-x-1.5 ${
                view === 'admin'
                  ? 'bg-[#2C352E] text-[#F5F2EB] shadow-sm'
                  : 'bg-white/60 text-[#2C352E] hover:bg-white border border-[#2C352E]/15'
              }`}
            >
              <ShieldCheck className="w-3.5 h-3.5" />
              <span>Admin & Accounting</span>
            </button>

            {isAuthenticated && view === 'admin' && (
              <button
                onClick={handleLogout}
                title="Logout admin session"
                className="p-2 text-[#2C352E]/70 hover:text-red-700 hover:bg-red-50 rounded-full transition-colors ml-1"
              >
                <LogOut className="w-4 h-4" />
              </button>
            )}
          </div>
        </div>
      </header>

      {/* ========================================================================= */}
      {/* 1. PUBLIC STOREFRONT VIEW */}
      {/* ========================================================================= */}
      {view === 'store' && (
        <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
          
          {/* Hero Banner */}
          <section className="relative overflow-hidden rounded-3xl bg-[#2C352E] text-[#F5F2EB] p-8 md:p-14 shadow-xl">
            <div className="relative z-10 max-w-2xl space-y-4">
              <div className="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-[#D4C3A3]/20 border border-[#D4C3A3]/30 text-xs tracking-widest uppercase text-[#D4C3A3]">
                <Sparkles className="w-3.5 h-3.5" />
                <span>Pure Fiber Craftsmanship</span>
              </div>
              <h1 className="font-serif text-3xl sm:text-5xl font-normal tracking-tight leading-tight">
                Slow Crafted Yarn Elegance for Modern Living.
              </h1>
              <p className="text-sm sm:text-base text-[#F5F2EB]/80 font-light leading-relaxed">
                Hand-crocheted and spun with sustainably harvested organic merino, alpaca, and cotton. Designed to bring organic warmth into your wardrobe and home.
              </p>
              <div className="pt-2 flex flex-wrap gap-4 text-xs font-medium tracking-wider">
                <span className="flex items-center gap-1.5 bg-white/10 px-3.5 py-1.5 rounded-full">
                  <CheckCircle2 className="w-3.5 h-3.5 text-[#D4C3A3]" /> 100% Hand Crocheted
                </span>
                <span className="flex items-center gap-1.5 bg-white/10 px-3.5 py-1.5 rounded-full">
                  <CheckCircle2 className="w-3.5 h-3.5 text-[#D4C3A3]" /> Ethically Sourced Fibers
                </span>
                <span className="flex items-center gap-1.5 bg-white/10 px-3.5 py-1.5 rounded-full">
                  <CheckCircle2 className="w-3.5 h-3.5 text-[#D4C3A3]" /> Made to Cherish
                </span>
              </div>
            </div>

            {/* Decorative background logo ring watermark */}
            <div className="absolute -right-12 -bottom-16 w-80 h-80 rounded-full border border-white/10 opacity-30 pointer-events-none flex items-center justify-center">
              <span className="font-serif text-9xl text-white/5 font-extrabold">N</span>
            </div>
          </section>

          {/* Filtering and Search Controls */}
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#2C352E]/10 pb-6">
            
            {/* Category pills */}
            <div className="flex flex-wrap gap-2">
              {['All', 'Wearables', 'Accessories', 'Home Decor', 'Plushies'].map((cat) => (
                <button
                  key={cat}
                  onClick={() => setSelectedCategory(cat)}
                  className={`px-4 py-2 rounded-full text-xs font-medium transition-all ${
                    selectedCategory === cat
                      ? 'bg-[#2C352E] text-[#F5F2EB] shadow-sm'
